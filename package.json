{
  "name": "newbie-launcher",
  "version": "0.1.3",
  "description": "Newbie Launcher — a calm, fast Minecraft: Java Edition launcher with Modrinth, loadouts and one-click repair.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Deepma1ya",
    "email": "deepma1ya@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Deepma1ya/Newbie-Launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deepma1ya/Newbie-Launcher.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:publish": "npm run build && electron-builder --win nsis --x64 --publish always",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.106.0",
    "adm-zip": "0.6.1",
    "archiver": "8.0.0",
    "electron-updater": "6.8.11",
    "framer-motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "semver": "7.8.6",
    "smol-toml": "1.4.2",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/archiver": "6.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.4.21",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
